{
    "name": "sieve-backend",
    "version": "0.1.0",
    "license": "GPL-3.0-or-later",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "prod": "node dist/src/main.js",
        "lint": "biome check",
        "lint:fix": "biome check --fix --unsafe",
        "format": "biome format --write",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "license-check": "license-checker-rseidelsohn --onlyAllow --customPath ../../.license-checker.json --summary",
        "generate:client:prisma": "pnpm prisma generate",
        "generate:client:orval": "pnpm run build && node dist/scripts/generate-client.js",
        "generate:clients": "pnpm run generate:client:prisma && pnpm run generate:client:orval"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.16",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.16",
        "@nestjs/platform-express": "^11.1.16",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/terminus": "^11.1.1",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@scalar/nestjs-api-reference": "^1.0.29",
        "@thallesp/nestjs-better-auth": "^2.5.1",
        "better-auth": "^1.4.21",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "graphql": "^16.13.1",
        "joi": "^18.0.2",
        "orval": "^7.21.0",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.7",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.16",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.5.0",
        "@types/supertest": "^7.2.0",
        "globals": "^17.4.0",
        "jest": "^30.3.0",
        "license-checker-rseidelsohn": "^4.4.2",
        "prisma": "^7.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
